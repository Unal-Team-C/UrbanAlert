# Copiar a .env para cambiar credenciales locales. Valores solo para desarrollo; .env no se versiona.
GATEWAY_PORT=8080
# Clave que el gateway envía a Auditoria en X-Urban-Gateway-Key.
GATEWAY_SHARED_SECRET=urbanalert-gateway-local
# URL pública por la que los navegadores llegan al gateway, usada por Multimedia para construir
# la URL de las imágenes (PUBLIC_IMAGE_BASE_URL). Por defecto asume que el navegador corre en la
# misma máquina que el compose (http://localhost:8080). Detrás de un túnel de Cloudflare o un
# dominio propio, fijarla a esa URL pública, por ejemplo https://urbanalert.midominio.com
# (sin "/" al final). GATEWAY_PORT no sirve para esto: el túnel no pasa por el puerto del host.
GATEWAY_PUBLIC_URL=http://localhost:8080

RABBITMQ_USER=urbanalert
RABBITMQ_PASSWORD=urbanalert

REPORTES_DB_USER=urbanalert
REPORTES_DB_PASSWORD=urbanalert
AUDIT_WRITER_PASSWORD=audit_writer
AUDIT_READER_PASSWORD=audit_reader
REPORTES_READER_PASSWORD=reportes_reader
# true: Auditoria acepta consultas sin Cognito, con la identidad en los headers X-Usuario-Id y
# X-Usuario-Rol (por defecto admin). Cualquiera que llegue al gateway puede elegir su identidad.
AUDITORIA_MODO_DESARROLLO=false

GEOESPACIAL_DB_USER=geospatial
GEOESPACIAL_DB_PASSWORD=geospatial

USUARIOS_DB_USER=urbanalert
USUARIOS_DB_PASSWORD=urbanalert

# Cloudflare Tunnel con nombre (perfil "tunnel"). Token del túnel creado en
# Cloudflare > Zero Trust > Networks > Tunnels. No se necesita para "tunnel-rapido".
CLOUDFLARE_TUNNEL_TOKEN=
